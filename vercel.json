{
  "functions": {
    "api/search.js": { "maxDuration": 30 },
    "api/jobs.js": { "maxDuration": 30 },
    "api/health.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/search",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
